<?xml version="1.0" encoding="UTF-8"?>

<plugin
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
    id="cordova-plugin-datadog-rum"
    version="1.0.0">

    <name>DatadogRum</name>

    <js-module src="www/datadogRum.js" name="DatadogRum">
        <clobbers target="window.plugins.datadogRum" />
    </js-module>

    <platform name="android">

        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="DatadogRum">
                <param
                    name="android-package"
                    value="com.company.datadog.DatadogRum" />
            </feature>
        </config-file>

        src/android/DatadogRum.java

    </platform>

    <platform name="ios">

        src/ios/DatadogRum.swift

    </platform>

</plugin>


