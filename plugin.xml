<?xml version="1.0" encoding="UTF-8"?>

<plugin
    id="cordova-plugin-datadog-rum"
    version="1.0.0"
    xmlns="http://apache.org/cordova/ns/plugins/1.0">

    <name>DatadogRum</name>

    www/datadogRum.js

        <clobbers target="window.plugins.datadogRum" />
    </js-module>

    <platform name="android">

        <config-file
            target="res/xml/config.xml"
            parent="/*">

            <feature name="DatadogRum">
                <param
                    name="android-package"
                    value="com.company.datadog.DatadogRum"/>
            </feature>

        </config-file>

        src/android/DatadogRum.java
    </platform>

    <platform name="ios">

        <config-file
            target="config.xml"
            parent="/*">

            <feature name="DatadogRum">
                <param
                    name="ios-package"
                    value="DatadogRum"/>
            </feature>

        </config-file>

        src/ios/DatadogRum.swift
    </platform>

</plugin>